# Ordering, accounts and checkout are off while the API is retired. Set this to
# exactly "true" (and restore REACT_APP_API_BASE_URL below) to bring them back.
REACT_APP_ORDERING_ENABLED=false

# Blank on purpose: keeps the retired API host out of the production bundle so a
# stray credentialed request can never reach it. Restore this value alongside the
# flag above when ordering comes back.
REACT_APP_API_BASE_URL=
# REACT_APP_API_BASE_URL=https://api.gmpetitcafe.com/api/v1

# The deploy syncs build/ straight to a public bucket, so don't publish 3 MB of
# readable source alongside it.
GENERATE_SOURCEMAP=false
